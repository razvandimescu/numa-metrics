# Build context is the repo root (see docker-compose.yml: context: ..).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /drain-consumer ./cmd/drain-consumer

FROM gcr.io/distroless/static-debian12
COPY --from=build /drain-consumer /drain-consumer
ENTRYPOINT ["/drain-consumer"]
